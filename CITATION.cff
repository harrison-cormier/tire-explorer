    given-names: Harrison
    affiliation: University of Waterloo
  - family-names: Pacek
    given-names: Ashley
    affiliation: University of Waterloo
  - family-names: Blinova
    given-names: Varvara
    affiliation: University of Waterloo
repository-code: "https://github.com/harrison-cormier/tire-explorer"
license: Apache-2.0
date-released: "2026-11-18"
keywords:
  - tires
  - braking distance
  - fleet safety
  - winter tires
  - screening model
